{
  "name": "madcoders",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sh -c 'set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a; exec astro dev'",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:check": "node --experimental-strip-types scripts/db-check.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/vercel": "^11.0.11",
    "@base-ui/react": "^1.8.0",
    "@clerk/astro": "^4.1.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
