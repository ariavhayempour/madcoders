---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { team } from '../data/team';

const initials = (name: string) =>
  name.split(/[\s&]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '_');

// Roster rows are the buffer's content lines; TBD seats are unfilled and stay out of the file.
const groups = team.map((g) => ({
  key: slug(g.title),
  title: g.title,
  members: g.members.filter((m) => m.name !== 'TBD'),
}));
---
<BaseLayout
  title="Our Team"
  description="The undergraduate students who lead and build MadCoders at UW-Madison."
  path="/team"
>
  <div class="editor-grid">
    <div class="gutter" aria-hidden="true" data-line-gutter></div>

    <div class="min-w-0">
      <div class="mx-auto max-w-4xl px-6 pt-14 sm:pt-16">
        <p class="mb-3 font-mono text-[13px] text-editor-text-faint"># team.json</p>
        <h1 class="text-[clamp(2.2rem,4.6vw,3.4rem)] leading-[1.08] font-extrabold tracking-[-0.03em] text-balance text-foreground">
          Built by Badgers.
        </h1>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-editor-text-dim">
          Undergraduates from across UW–Madison, collaborating on coding projects, skill-building, and technology leadership.
        </p>
      </div>

      <div class="mx-auto max-w-4xl px-6 py-12">
        <div class="roster overflow-hidden rounded-lg border border-editor-line bg-card">
          <div class="flex items-center gap-4 border-b border-editor-line bg-editor-2 px-5 py-2.5 font-mono text-[12px] text-editor-text-dim">
            <span class="font-semibold text-editor-text">team.json</span>
          </div>

          <div class="py-4 font-mono text-[13px] leading-[1.6]">
            <p class="px-5 text-editor-text-faint">{'{'}</p>

            {groups.map((group, gi) => (
              <section class="group-block">
                <h2 class="px-5 pt-4 pb-1 pl-8">
                  <span class="text-syn-key">"{group.key}"</span><span class="text-editor-text-faint">: [</span>
                </h2>

                <ul class="list-none p-0">
                  {group.members.map((m, i) => (
                    <li class="member grid grid-cols-[1.75rem_1fr] items-start gap-x-3 py-2 pr-5 pl-8 transition-colors hover:bg-editor-2">
                      {m.photo ? (
                        <Image
                          class="mt-0.5 size-7 rounded-full object-cover ring-1 ring-editor-line"
                          style={{ objectPosition: m.photoPosition ?? 'center' }}
                          src={m.photo}
                          alt={m.name}
                          width={112}
                          height={112}
                          loading="lazy"
                        />
                      ) : (
                        <span
                          class="mt-0.5 grid size-7 place-items-center rounded-full bg-cardinal-tint text-[10px] font-bold text-cardinal-700 ring-1 ring-editor-line"
                          aria-hidden="true"
                        >{initials(m.name)}</span>
                      )}

                      <div class="min-w-0">
                        <p class="flex flex-wrap items-baseline gap-x-2.5">
                          <span class="text-editor-text-faint">{'{'}</span>
                          <span class="font-sans text-[15px] font-semibold tracking-[-0.01em] text-foreground">{m.name}</span>
                          <span class="text-syn-str">"{m.role}"</span>
                        </p>
                        <p class="flex flex-wrap items-baseline gap-x-2.5 text-[12px]">
                          <span class="text-editor-text-dim">{m.major}</span>
                          <span class="text-editor-text-faint">{'}'}{i < group.members.length - 1 ? ',' : ''}</span>
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>

                <p class="px-5 pt-1 pl-8 text-editor-text-faint">]{gi < groups.length - 1 ? ',' : ''}</p>
              </section>
            ))}

            <p class="px-5 pt-3 text-editor-text-faint">{'}'}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editor-grid {
    display: grid;
    grid-template-columns: 52px 1fr;
  }
  .gutter {
    border-right: 1px solid var(--editor-line);
    background: var(--editor);
  }

  /* Indent guide: the editor's nesting rule beside each array's rows. */
  .group-block {
    position: relative;
  }
  .group-block::before {
    content: '';
    position: absolute;
    top: 2.1rem;
    bottom: 1.5rem;
    left: 1.55rem;
    width: 1px;
    background: var(--editor-line);
  }

  /* Hovering a row lights its indent rule cardinal, the way an editor marks the caret line. */
  .member {
    box-shadow: inset 1px 0 0 transparent;
  }
  .member:hover {
    box-shadow: inset 1px 0 0 var(--cardinal);
  }

  @media (max-width: 640px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
    .gutter {
      display: none;
    }
  }
</style>

<script>
  import { mountLineGutter } from '../lib/line-gutter';
  mountLineGutter();
</script>
