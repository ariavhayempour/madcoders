---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { team } from '../data/team';

const initials = (name: string) =>
  name.split(/[\s&]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '_');
---
<BaseLayout
  title="Our Team"
  description="The undergraduate students who lead and build MadCoders at UW-Madison."
  path="/team"
>
  <div class="editor-grid">
    <div class="gutter" aria-hidden="true" data-line-gutter></div>

    <div class="min-w-0">
      <div class="mx-auto max-w-4xl px-6 pt-14 sm:pt-16">
        <p class="mb-3 font-mono text-[13px] text-editor-text-faint"># team.json</p>
        <h1 class="text-[clamp(2.2rem,4.6vw,3.4rem)] leading-[1.08] font-extrabold tracking-[-0.03em] text-balance text-foreground">
          Built by Badgers.
        </h1>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-editor-text-dim">
          Undergraduates from across UW–Madison, collaborating on coding projects, skill-building, and technology leadership.
        </p>
      </div>

      <div class="mx-auto max-w-4xl px-6 py-12">
        {team.map((group) => (
          <section class="mt-12 first:mt-0">
            <h2 class="mb-4 font-mono text-[13px] font-semibold text-cardinal-700">"{slug(group.title)}": [</h2>
            <ul class="grid list-none gap-4 p-0 pl-4 [grid-template-columns:repeat(auto-fill,minmax(15rem,1fr))]">
              {group.members.filter((m) => m.name !== 'TBD').map((m) => (
                <li class="rounded-lg border border-editor-line bg-editor-2 p-6 text-center transition-colors hover:border-ink-3">
                  {m.photo ? (
                    <Image class="mx-auto mb-4 size-20 rounded-full object-cover" style={{ objectPosition: m.photoPosition ?? 'center' }} src={m.photo} alt={m.name} width={200} height={200} loading="lazy" />
                  ) : (
                    <span class="mx-auto mb-4 grid size-20 place-items-center rounded-full border border-editor-line bg-cardinal-tint font-mono text-xl font-bold text-cardinal-700">{initials(m.name)}</span>
                  )}
                  <h3 class="text-lg font-semibold leading-tight text-foreground">{m.name}</h3>
                  <p class="mt-1 font-mono text-sm font-semibold text-cardinal-700">{m.role}</p>
                  <p class="font-mono text-xs text-editor-text-dim">{m.major}</p>
                  <p class="font-mono text-xs text-editor-text-faint">{m.classOf}</p>
                </li>
              ))}
            </ul>
            <p class="mt-4 pl-4 font-mono text-[13px] text-cardinal-700">]</p>
          </section>
        ))}

        <section class="mt-16 rounded-lg border border-editor-line bg-editor-2 p-8 sm:p-10">
          <p class="mb-2 font-mono text-[11px] text-cardinal-700">// join.md</p>
          <h2 class="text-2xl font-bold tracking-tight text-foreground">Join the team</h2>
          <p class="mt-2 max-w-[60ch] text-lg text-editor-text-dim">
            Want to lead, develop, or organize events for MadCoders? Tell us a bit about yourself.
          </p>
          <div class="mt-6">
            <a href="/contact?type=join" class="inline-flex h-10 items-center justify-center rounded-md bg-cardinal px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-cardinal-700">
              Contact us to join
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .editor-grid {
    display: grid;
    grid-template-columns: 52px 1fr;
  }
  .gutter {
    border-right: 1px solid var(--editor-line);
    background: var(--editor);
  }
  @media (max-width: 640px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
    .gutter {
      display: none;
    }
  }
</style>

<script>
  import { mountLineGutter } from '../lib/line-gutter';
  mountLineGutter();
</script>
