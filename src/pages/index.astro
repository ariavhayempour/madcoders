---
// Per-request SSR so the upcoming-meetings rail reflects the events table without a redeploy.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { digests } from '../data/digests';
import { team } from '../data/team';
import { listEvents } from '../db/event';
import { splitMeetings, type MeetingView } from '../lib/split-meetings';
import { REVALIDATE_CACHE_CONTROL } from '../lib/cache-headers';

Astro.response.headers.set('Cache-Control', REVALIDATE_CACHE_CONTROL);

const rows = await listEvents();
const view: MeetingView[] = rows.map((r) => ({
  id: r.slug,
  date: r.date,
  title: r.title ?? undefined,
  time: r.time ?? undefined,
  location: r.location ?? undefined,
}));
const today = new Date().toISOString().slice(0, 10);
const { upcoming } = splitMeetings(view, today);
const nextMeeting = upcoming[0];

const formatNextDate = (isoDate: string) => {
  const d = new Date(isoDate + 'T00:00:00Z');
  return new Intl.DateTimeFormat('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(d);
};

const initials = (name: string) =>
  name.split(/[\s&]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

// Flat roster for the front-page listing; drop unfilled placeholder slots, cap to a handful.
const members = team
  .flatMap((g) => g.members)
  .filter((m) => m.name !== 'TBD' && m.major !== 'TBD')
  .slice(0, 4);
---
<BaseLayout
  title="MadCoders"
  description="UW-Madison Madison Coders Club — building software, learning together, and exploring technology."
  path="/"
>
  <div class="editor-grid">
    <!-- Persistent line-number gutter running the page's full content height -->
    <div class="gutter" aria-hidden="true" data-line-gutter></div>

    <div class="editor-col">
      <!-- Front-matter block -->
      <div class="mx-auto max-w-3xl px-6 pt-14 sm:pt-16">
        <pre class="frontmatter font-mono text-[13px] leading-[1.9] text-editor-text-dim"><span class="text-editor-text-faint"># index.md</span>
<span class="text-editor-text-faint">---</span>
<span class="text-syn-key">org:</span> <span class="text-syn-str">"MadCoders"</span>
<span class="text-syn-key">school:</span> <span class="text-syn-str">"University of Wisconsin–Madison"</span>
<span class="text-syn-key">status:</span> <span class="text-syn-fn">recruiting</span><span class="text-editor-text-faint">(</span><span class="text-syn-str">"fall-2026"</span><span class="text-editor-text-faint">)</span>
<span class="text-editor-text-faint">---</span><span class="cursor" aria-hidden="true"></span></pre>

        <h1 class="mt-7 max-w-[16ch] text-[clamp(2.4rem,5.2vw,3.8rem)] leading-[1.08] font-extrabold tracking-[-0.03em] text-balance text-foreground">
          Student-run.<br />Always <span class="text-cardinal-700">shipping.</span>
        </h1>
        <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-editor-text-dim">
          MadCoders is UW–Madison's student software club — weekly builds, real projects, and a community that ships. No experience required.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/meetings" class="inline-flex h-11 items-center gap-2 rounded-md bg-cardinal px-6 text-[15px] font-semibold text-primary-foreground transition-colors hover:bg-cardinal-700">
            RSVP for next meeting →
          </a>
          <a href="/team" class="inline-flex h-11 items-center rounded-md border border-editor-line px-6 text-[15px] font-semibold text-foreground transition-colors hover:border-ink-3">
            See the team
          </a>
        </div>
      </div>

      <!-- Mission panel -->
      <div class="mx-auto max-w-3xl px-6 pt-16">
        <p class="mb-3 font-mono text-[11px] text-cardinal-700">// mission</p>
        <div class="rounded-lg border border-editor-line bg-editor-2">
          <div class="flex items-center gap-2 border-b border-editor-line px-5 py-2.5 font-mono text-[12px] font-semibold text-editor-text-dim">
            📄 README.md
          </div>
          <div class="px-6 py-7 sm:px-8">
            <h2 class="text-2xl font-bold tracking-tight text-foreground">Building software and community at UW–Madison.</h2>
            <p class="mt-4 text-[1.02rem] leading-relaxed text-editor-text-dim">
              MadCoders is a student organization dedicated to software engineering, open-source collaboration, and technology skills — whether you're writing your first lines of code or shipping full-stack applications.
            </p>
            <p class="mt-3 text-[1.02rem] leading-relaxed text-editor-text-dim">
              Our weekly meetings cover coding tutorials, project collaboration, interview prep, and tech discussions designed to help every member build confidence as a developer.
            </p>
          </div>
        </div>
      </div>

      <!-- Next meeting: rendered as a key:value data block, RSVP undecorated and unmissable -->
      <div class="mx-auto max-w-3xl px-6 pt-16">
        <p class="mb-3 font-mono text-[11px] text-cardinal-700">// meetings.md</p>
        <div class="overflow-hidden rounded-lg border border-editor-line font-mono text-sm">
          <div class="flex items-center justify-between bg-editor-2 px-5 py-2.5 text-editor-text-dim">
            <span>next_session</span>
            {nextMeeting ? (
              <span class="flex items-center gap-1.5 text-success"><span class="size-1.5 rounded-full bg-success"></span>open</span>
            ) : (
              <span class="text-editor-text-faint">tbd</span>
            )}
          </div>
          {nextMeeting ? (
            <div>
              <div class="flex justify-between border-t border-editor-line px-5 py-3"><span class="text-editor-text-faint">title</span><span class="font-semibold text-foreground">{nextMeeting.title || 'MadCoders meeting'}</span></div>
              <div class="flex justify-between border-t border-editor-line px-5 py-3"><span class="text-editor-text-faint">date</span><span class="font-semibold text-foreground">{formatNextDate(nextMeeting.date)}</span></div>
              {nextMeeting.time && <div class="flex justify-between border-t border-editor-line px-5 py-3"><span class="text-editor-text-faint">time</span><span class="font-semibold text-foreground">{nextMeeting.time}</span></div>}
              {nextMeeting.location && <div class="flex justify-between border-t border-editor-line px-5 py-3"><span class="text-editor-text-faint">room</span><span class="font-semibold text-foreground">{nextMeeting.location}</span></div>}
              <a href="/meetings" class="block border-t border-editor-line bg-cardinal py-3.5 text-center font-sans font-semibold text-primary-foreground transition-colors hover:bg-cardinal-700">RSVP →</a>
            </div>
          ) : (
            <div>
              <div class="flex justify-between border-t border-editor-line px-5 py-3"><span class="text-editor-text-faint">title</span><span class="font-semibold text-foreground">no upcoming meetings</span></div>
              <div class="flex justify-between border-t border-editor-line px-5 py-3"><span class="text-editor-text-faint">location</span><span class="font-semibold text-foreground">tbd</span></div>
              <a href="/meetings" class="block border-t border-editor-line bg-cardinal py-3.5 text-center font-sans font-semibold text-primary-foreground transition-colors hover:bg-cardinal-700">View all meetings →</a>
            </div>
          )}
        </div>
      </div>

      <!-- Projects as a directory listing -->
      <div class="mx-auto max-w-3xl px-6 pt-16">
        <p class="mb-1 font-mono text-[11px] text-cardinal-700">// projects/</p>
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Projects & technical tracks</h2>
        <p class="mt-2 mb-6 max-w-[60ch] text-editor-text-dim">Student-led development tracks and coding projects.</p>
        <ul class="divide-y divide-editor-line rounded-lg border border-editor-line">
          {digests.map((d) => (
            <li class="flex items-start gap-4 px-5 py-5 transition-colors hover:bg-editor-2">
              <span class="font-mono text-lg" aria-hidden="true">{d.icon}</span>
              <div>
                <p class="font-mono text-sm font-semibold text-foreground">{d.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/</p>
                <p class="mt-1 text-editor-text-dim">{d.description}</p>
              </div>
            </li>
          ))}
          <li class="flex items-start gap-4 border-t border-dashed border-cardinal/40 px-5 py-5">
            <span class="font-mono text-lg" aria-hidden="true">✨</span>
            <div>
              <p class="font-mono text-sm font-semibold text-foreground">your-project/</p>
              <p class="mt-1 text-editor-text-dim">Have an idea for a project or tech stack? Help us build the next track.</p>
              <a href="/create-next-digest" class="mt-2 inline-block font-mono text-sm font-semibold text-cardinal-700 hover:underline">git init →</a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Team roster as JSON -->
      <div class="mx-auto max-w-3xl px-6 pt-16 pb-20">
        <p class="mb-1 font-mono text-[11px] text-cardinal-700">// team.json</p>
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-2xl font-bold tracking-tight text-foreground">Built by Badgers.</h2>
          <a href="/team" class="font-mono text-sm font-semibold text-cardinal-700 hover:underline">view all →</a>
        </div>
        <ul class="mt-6 divide-y divide-editor-line rounded-lg border border-editor-line font-mono text-sm">
          {members.map((m) => (
            <li class="flex items-center gap-4 px-5 py-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-cardinal-tint text-xs font-bold text-cardinal-700">{initials(m.name)}</span>
              <span class="min-w-0 flex-1 truncate font-sans font-semibold text-foreground">{m.name}</span>
              <span class="hidden shrink-0 text-cardinal-700 sm:inline">{m.role}</span>
              <span class="hidden shrink-0 text-editor-text-faint md:inline">{m.major}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Closing: full-bleed, outside the gutter grid -->
  <div class="border-t border-editor-line bg-cardinal">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-6 py-16 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="max-w-[16ch] text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight font-extrabold tracking-tight text-primary-foreground">
        Build with MadCoders.
      </h2>
      <a href="/contact?type=digest" class="inline-flex h-12 shrink-0 items-center justify-center rounded-md bg-background px-6 text-base font-semibold text-cardinal-700 transition-colors hover:bg-editor-2">
        Pitch a project →
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .editor-grid {
    display: grid;
    grid-template-columns: 52px 1fr;
  }
  .gutter {
    border-right: 1px solid var(--editor-line);
    background: var(--editor);
  }
  .gutter::before {
    content: '';
    display: block;
  }
  .editor-col {
    min-width: 0;
  }
  .frontmatter {
    white-space: pre-wrap;
  }
  .cursor {
    display: inline-block;
    width: 7px;
    height: 15px;
    background: var(--cardinal);
    vertical-align: text-bottom;
    margin-left: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1s step-end infinite;
    }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @media (max-width: 640px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
    .gutter {
      display: none;
    }
  }
</style>

<script>
  import { mountLineGutter } from '../lib/line-gutter';
  mountLineGutter();
</script>

