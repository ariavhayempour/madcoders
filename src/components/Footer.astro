---
// Shared footer, identical on every public page; Team lives here (moved out of the primary nav).
const explore = [
  { href: '/', label: 'index.md' },
  { href: '/meetings', label: 'meetings.md' },
  { href: '/team', label: 'team.json' },
  { href: '/contact', label: 'contact.md' },
];
const current = Astro.url.pathname;
const isAdmin = current.startsWith('/admin');
---
{!isAdmin && (
  <footer class="border-t border-editor-line bg-editor-2 text-editor-text-dim">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <div class="mb-4 flex items-center gap-2 font-mono text-sm font-semibold text-editor-text">
          <span class="grid size-5 place-items-center rounded bg-cardinal font-mono text-[10px] font-bold text-primary-foreground">{'{}'}</span>
          madcoders
        </div>
        <p class="max-w-[38ch] text-sm leading-relaxed">
          A student-run coding organization at UW–Madison building projects, sharing technical knowledge, and fostering software developers.
        </p>
        <p class="mt-4 font-mono text-xs text-editor-text-faint">Madison, WI, 53706</p>
      </div>
      <nav aria-label="Explore">
        <h2 class="mb-4 font-mono text-[11px] font-semibold tracking-[0.1em] text-editor-text-faint uppercase">// explore</h2>
        <ul class="space-y-2 font-mono text-sm">
          {explore.map((l) => (
            <li><a class="transition-colors hover:text-editor-text" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Connect">
        <h2 class="mb-4 font-mono text-[11px] font-semibold tracking-[0.1em] text-editor-text-faint uppercase">// connect</h2>
        <ul class="space-y-2 font-mono text-sm">
          <li><a class="transition-colors hover:text-editor-text" href="https://www.instagram.com/madcodersuw/" target="_blank" rel="noopener">instagram</a></li>
          <li><a class="transition-colors hover:text-editor-text" href="https://www.linkedin.com/company/madcoders/posts/" target="_blank" rel="noopener">linkedin</a></li>
        </ul>
      </nav>
    </div>
    <div class="border-t border-editor-line">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-6 pt-4 pb-6 font-mono text-xs text-editor-text-faint sm:flex-row">
        <span>For educational purposes only</span>
        <a class="transition-colors hover:text-editor-text" href="https://github.com/ariavhayempour/madcoders" target="_blank" rel="noopener">GitHub</a>
        <a class="transition-colors hover:text-editor-text" href="/admin">Admin Portal</a>
      </div>
    </div>
  </footer>
)}
