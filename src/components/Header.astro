---
// Every entry is a real <a href> so browser back/forward works natively.
import MobileNav from './MobileNav';
import AdminNav, { type AdminLink } from './AdminNav';
import { UserButton } from '@clerk/astro/components';

interface Props {
  adminLinks?: AdminLink[];
}

const { adminLinks } = Astro.props;

const links = [
  { href: '/', label: 'index.md' },
  { href: '/meetings', label: 'meetings.md' },
  { href: '/events', label: 'events.md' },
  { href: '/team', label: 'team.json' },
  { href: '/contact', label: 'contact.md' },
];

const current = Astro.url.pathname;
const isAdmin = current.startsWith('/admin');
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
{isAdmin ? (
  <header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md">
    <nav aria-label="Primary" class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-3.5">
      {adminLinks && (
        <div class="lg:hidden">
          <AdminNav client:load links={adminLinks} />
        </div>
      )}
      <a href="/" class="mr-auto flex items-center gap-3">
        <span class="font-serif text-[1.35rem] font-bold tracking-tight text-foreground">MadCoders</span>
      </a>
      <div class="flex items-center pl-1">
        <UserButton />
      </div>
    </nav>
  </header>
) : (
  <div class="sticky top-0 z-40">
    {/* Title bar: traffic-light chrome, the window's identity */}
    <div class="flex items-center gap-2 border-b border-editor-line bg-editor px-4 py-2">
      <span class="size-2.5 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-[#28c840]" aria-hidden="true"></span>
      <span class="ml-2 hidden font-mono text-xs text-editor-text-faint sm:inline">madcoders — ~/uw-madison/madcoders</span>
      <div class="ml-auto md:hidden">
        <MobileNav links={links} />
      </div>
    </div>

    {/* Tab bar: file tabs double as page nav; the active tab carries the cardinal underline */}
    <nav aria-label="Primary" class="hidden items-stretch border-b border-editor-line bg-editor-2 md:flex">
      <a href="/" class="flex items-center gap-2 border-r border-editor-line px-4 py-2.5 font-mono text-[13px] font-semibold text-editor-text">
        <span class="grid size-5 place-items-center rounded bg-cardinal font-mono text-[10px] font-bold text-primary-foreground">{'{}'}</span>
        madcoders
      </a>
      <ul class="flex items-stretch overflow-x-auto">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'relative flex items-center gap-2 border-r border-editor-line px-5 py-2.5 font-mono text-[13px] whitespace-nowrap transition-colors',
                isActive(l.href)
                  ? 'top-px border-t-2 border-t-cardinal bg-background text-editor-text'
                  : 'text-editor-text-faint hover:text-editor-text-dim',
              ]}
            >
              <span class:list={['size-1.5 rounded-full bg-cardinal', !isActive(l.href) && 'opacity-0']} aria-hidden="true"></span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/meetings"
        class="ml-auto flex items-center gap-2 bg-cardinal px-6 py-2.5 font-mono text-[13px] font-semibold text-primary-foreground transition-colors hover:bg-cardinal-700"
      >
        <span class="size-1.5 rounded-full bg-primary-foreground" aria-hidden="true"></span>
        RSVP
      </a>
    </nav>
  </div>
)}
