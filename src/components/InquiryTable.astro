---
import type { SubmissionRow, SubmissionType } from '../db/schema';
import Badge from './admin/Badge.astro';

interface Props {
  submissions: SubmissionRow[];
}
const { submissions } = Astro.props;

const formatTimestamp = (iso: string): string =>
  new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });

const label: Record<SubmissionType, string> = {
  inquiry: 'General',
  join: 'Join the team',
  digest: 'New digest',
};
const th = 'border-b border-border/60 bg-muted/40 px-5 py-3 text-left text-[0.7rem] font-bold tracking-[0.08em] text-muted-foreground uppercase';
const td = 'border-b border-border/50 px-5 py-3.5 align-top';
---
{
  submissions.length === 0 ? (
    <p class="px-5 py-8 text-muted-foreground">No submissions yet.</p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr>
            <th scope="col" class={th}>Name</th>
            <th scope="col" class={th}>Email</th>
            <th scope="col" class={th}>Type</th>
            <th scope="col" class={th}>Message</th>
            <th scope="col" class={th}>Received</th>
            <th scope="col" class={`${th} w-24 text-right`} style="display: none;" data-select-all-cell>
              <div class="flex items-center justify-end gap-3">
                <button
                  type="button"
                  id="delete-selected-btn"
                  style="display: none;"
                  class="text-xs font-semibold whitespace-nowrap text-destructive hover:underline cursor-pointer"
                >
                  Delete (0)
                </button>
                <input
                  type="checkbox"
                  id="select-all-submissions"
                  class="size-4 cursor-pointer align-middle accent-primary"
                  aria-label="Select all submissions"
                />
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          {submissions.map((s) => (
            <tr
              class="transition-colors hover:bg-muted/40 cursor-pointer group"
              data-id={s.id}
              data-read={s.is_read ? "true" : "false"}
              data-type={s.submission_type}
              data-search={`${s.name} ${s.email} ${s.message}`.toLowerCase()}
              title={s.is_read ? 'Mark as unread' : 'Mark as read'}
            >
              <td class={`${td} ${s.is_read ? 'font-medium text-muted-foreground' : 'font-bold'}`}>
                {!s.is_read && <span class="mr-1.5 inline-block size-2 rounded-full bg-primary" aria-label="Unread"></span>}
                {s.name}
              </td>
              <td class={`${td} text-muted-foreground`}>{s.email}</td>
              <td class={td}><Badge variant={s.submission_type}>{label[s.submission_type]}</Badge></td>
              <td class={`${td} max-w-[40ch] whitespace-pre-wrap ${s.is_read ? 'text-muted-foreground' : 'font-medium'}`}>{s.message}</td>
              <td class={`${td} whitespace-nowrap text-muted-foreground`}>{formatTimestamp(s.created_at)}</td>
              <td class={`${td} w-24 text-right`} style="display: none;" data-action="select">
                <input
                  type="checkbox"
                  class="size-4 cursor-pointer align-middle accent-primary"
                  data-select-row
                  aria-label={`Select submission from ${s.name}`}
                />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
{submissions.length > 0 && (
  <p id="submissions-empty-filtered" class="hidden px-5 py-14 text-center text-muted-foreground">
    No submissions match these filters.
  </p>
)}

<script>
  const editBtn = document.getElementById('edit-inbox-btn');
  if (editBtn) {
    editBtn.addEventListener('click', () => {
      const isEditing = editBtn.getAttribute('data-editing') === 'true';
      const nextEditing = !isEditing;
      editBtn.setAttribute('data-editing', String(nextEditing));
      editBtn.textContent = nextEditing ? 'Done' : 'Edit';

      setEditing(nextEditing);
    });
  }

  const rowBox = (row: HTMLTableRowElement) =>
    row.querySelector<HTMLInputElement>('input[data-select-row]');

  // Select-all acts only on rows InquiryFilters currently shows.
  const visibleRows = () =>
    Array.from(document.querySelectorAll<HTMLTableRowElement>('tr[data-id]')).filter(
      (row) => !row.classList.contains('hidden'),
    );

  const selectedIds = (): number[] =>
    Array.from(document.querySelectorAll<HTMLTableRowElement>('tr[data-id]'))
      .filter((row) => rowBox(row)?.checked)
      .map((row) => Number(row.getAttribute('data-id')));

  const selectAll = document.getElementById('select-all-submissions') as HTMLInputElement | null;

  // Header box reflects the visible rows: all, none, or indeterminate.
  function syncSelectAll() {
    if (!selectAll) return;
    const rows = visibleRows();
    const checked = rows.filter((row) => rowBox(row)?.checked).length;
    selectAll.checked = rows.length > 0 && checked === rows.length;
    selectAll.indeterminate = checked > 0 && checked < rows.length;
  }

  function setRowSelected(row: HTMLTableRowElement, selected: boolean) {
    const box = rowBox(row);
    if (!box) return;
    box.checked = selected;
    row.classList.toggle('bg-primary/5', selected);
    syncSelectAll();
    document.dispatchEvent(new CustomEvent('submissions:selection'));
  }

  function setEditing(editing: boolean) {
    document.querySelectorAll<HTMLElement>('[data-action="select"], [data-select-all-cell]').forEach((cell) => {
      cell.style.display = editing ? 'table-cell' : '';
    });
    if (!editing) {
      document.querySelectorAll<HTMLTableRowElement>('tr[data-id]').forEach((row) => {
        const box = rowBox(row);
        if (box) box.checked = false;
        row.classList.remove('bg-primary/5');
      });
      syncSelectAll();
      document.dispatchEvent(new CustomEvent('submissions:selection'));
    }
    document.dispatchEvent(new CustomEvent('submissions:editing', { detail: { editing } }));
  }

  const isEditingNow = () =>
    document.getElementById('edit-inbox-btn')?.getAttribute('data-editing') === 'true';

  selectAll?.addEventListener('change', () => {
    const target = selectAll.checked;
    visibleRows().forEach((row) => {
      const box = rowBox(row);
      if (box) box.checked = target;
      row.classList.toggle('bg-primary/5', target);
    });
    syncSelectAll();
    document.dispatchEvent(new CustomEvent('submissions:selection'));
  });

  // Re-sync after a filter change, since the visible set defines the header state.
  document.addEventListener('submissions:changed', syncSelectAll);

  document.querySelectorAll<HTMLTableRowElement>('tr[data-id]').forEach(row => {
    rowBox(row)?.addEventListener('change', (e) => {
      e.stopPropagation();
      setRowSelected(row, rowBox(row)!.checked);
    });

    row.addEventListener('click', async (e) => {
      const id = row.getAttribute('data-id');
      const target = e.target as HTMLElement;

      // While editing, a row click selects instead of toggling read state.
      if (isEditingNow()) {
        if (target.closest('input[data-select-row]')) return;
        setRowSelected(row, !rowBox(row)?.checked);
        return;
      }

      // One-click toggle: unread -> read, read -> unread.
      const nextRead = row.getAttribute('data-read') !== 'true';
      row.setAttribute('data-read', String(nextRead));
      row.title = nextRead ? 'Mark as unread' : 'Mark as read';

      const nameTd = row.children[0] as HTMLElement;
      const msgTd = row.children[3] as HTMLElement;
      if (nextRead) {
        nameTd.className = nameTd.className.replace('font-bold', 'font-medium text-muted-foreground');
        nameTd.querySelector('span[aria-label="Unread"]')?.remove();
        msgTd.className = msgTd.className.replace('font-medium', 'text-muted-foreground');
      } else {
        nameTd.className = nameTd.className.replace('font-medium text-muted-foreground', 'font-bold');
        if (!nameTd.querySelector('span[aria-label="Unread"]')) {
          nameTd.insertAdjacentHTML('afterbegin', '<span class="mr-1.5 inline-block size-2 rounded-full bg-primary" aria-label="Unread"></span>');
        }
        msgTd.className = msgTd.className.replace('text-muted-foreground', 'font-medium');
      }
      document.dispatchEvent(new CustomEvent('submissions:changed'));

      fetch(`/admin/api/submissions/${id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ isRead: nextRead }),
      }).catch(() => {
        // Silently ignore or revert on error
      });
    });
  });

  const deleteBtn = document.getElementById('delete-selected-btn');

  function syncDeleteButton() {
    if (!deleteBtn) return;
    const count = selectedIds().length;
    deleteBtn.textContent = `Delete (${count})`;
    deleteBtn.style.display = isEditingNow() && count > 0 ? 'inline-flex' : 'none';
  }

  document.addEventListener('submissions:selection', syncDeleteButton);
  document.addEventListener('submissions:editing', syncDeleteButton);

  deleteBtn?.addEventListener('click', async () => {
    const ids = selectedIds();
    if (ids.length === 0) return;
    if (!confirm(`Delete ${ids.length} submission${ids.length === 1 ? '' : 's'}?`)) return;

    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tr[data-id]')).filter(
      (row) => ids.includes(Number(row.getAttribute('data-id'))),
    );
    rows.forEach((row) => (row.style.opacity = '0.5'));

    try {
      const res = await fetch('/admin/api/submissions', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ids }),
      });
      if (!res.ok) throw new Error();
      rows.forEach((row) => row.remove());
      syncSelectAll();
      syncDeleteButton();
      document.dispatchEvent(new CustomEvent('submissions:changed'));
    } catch {
      // Keep the selection intact so the user can retry.
      alert('Failed to delete submissions');
      rows.forEach((row) => (row.style.opacity = '1'));
    }
  });
</script>
